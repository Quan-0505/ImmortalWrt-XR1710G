#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled wait=0
    config_load daed
    config_get_bool enabled main enabled 1
    [ "$enabled" = 1 ] || return 0
    while ! ip -4 route show default | grep -q .; do
        [ "$wait" -lt 30 ] || break
        sleep 1
        wait=$((wait + 1))
    done
    install -d -m 0700 /etc/daed-rust
    mkdir -p /tmp/log/daed
    procd_open_instance
    procd_set_param command /usr/bin/daed run -c /etc/daed-rust/ --state /etc/daed-rust/daed.db
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile='1048576 1048576'
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/daed
    procd_close_instance
}

reload_service() {
    /usr/bin/daed reload --timeout 60s
}
