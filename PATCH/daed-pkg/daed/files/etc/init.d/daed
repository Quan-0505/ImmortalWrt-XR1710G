#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled listen go_config_dir respawn
	config_load daed
	config_get_bool enabled main enabled 1
	config_get listen main listen '0.0.0.0:2023'
	config_get go_config_dir main go_config_dir '/etc/daed-kdae'
	config_get_bool respawn main respawn 1
	[ "$enabled" = 1 ] || return 0
	[ -x /usr/bin/daed ] || return 1
	# Rust options (state/web_root/http_profile) are intentionally not Go flags.
	# The independent Go directory preserves the original Rust database.
	mkdir -p "$go_config_dir"
	chmod 700 "$go_config_dir"
	procd_open_instance
	procd_set_param command /usr/bin/daed run -c "$go_config_dir" -l "$listen"
	[ "$respawn" = 1 ] && procd_set_param respawn 3600 5 5
	procd_set_param limits nofile='1048576 1048576'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/daed
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger daed
}
